{
  "name": "supplies",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "pnpm --filter @supplies/web dev",
    "build": "prisma generate && pnpm --filter @supplies/web build",
    "start": "pnpm --filter @supplies/web start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:db": "tsx scripts/smoke.ts",
    "postinstall": "prisma generate",
    "db:up": "docker compose up -d",
    "db:migrate": "prisma migrate dev",
    "db:seed": "prisma db seed",
    "db:studio": "prisma studio",
    "bot:start": "tsx bot/index.ts",
    "bot:dev": "tsx watch bot/index.ts",
    "bot:webhook:set": "tsx scripts/set-telegram-webhook.ts",
    "bot:webhook:delete": "tsx scripts/set-telegram-webhook.ts --delete",
    "bot:local": "tsx scripts/set-telegram-webhook.ts --delete && tsx watch bot/index.ts",
    "digest:run": "tsx scripts/run-daily-digest.ts",
    "backup:prod": "tsx scripts/backup-prod.ts",
    "backup:verify": "tsx scripts/backup-verify.ts",
    "db:prod-copy": "tsx scripts/prod-copy.ts",
    "migrate:deploy": "tsx scripts/migrate-deploy.ts",
    "prepare": "husky",
    "verify": "pnpm lint && pnpm typecheck && pnpm -r typecheck && pnpm test && pnpm test:api",
    "test:e2e": "pnpm --filter @supplies/web test:e2e",
    "test:e2e:ui": "pnpm --filter @supplies/web test:e2e:ui",
    "web:dev": "pnpm --filter @supplies/web dev",
    "web:build": "pnpm --filter @supplies/web build",
    "api:dev": "pnpm --filter @supplies/api dev",
    "api:build": "pnpm --filter @supplies/api build",
    "api:start": "pnpm --filter @supplies/api start",
    "test:api": "pnpm --filter @supplies/api test",
    "test:api:e2e": "pnpm --filter @supplies/api test:e2e",
    "spa:dev": "pnpm --filter @supplies/spa dev",
    "spa:build": "pnpm --filter @supplies/spa build",
    "dev:all": "node scripts/check-dev-ports.mjs && concurrently -n web,api,spa -c cyan,magenta,green -k \"pnpm dev\" \"pnpm api:dev\" \"pnpm spa:dev\"",
    "dev:stop": "node scripts/check-dev-ports.mjs --kill"
  },
  "dependencies": {
    "@prisma/adapter-pg": "^7.8.0",
    "@supplies/bot": "workspace:*",
    "@supplies/core": "workspace:*",
    "@supplies/db": "workspace:*",
    "bcryptjs": "^3.0.3",
    "grammy": "^1.44.0"
  },
  "devDependencies": {
    "@types/node": "^20",
    "concurrently": "^10.0.5",
    "dotenv": "^17.4.2",
    "eslint": "^9",
    "eslint-config-next": "16.3.1",
    "husky": "^9.1.7",
    "lint-staged": "^17.4.1",
    "prisma": "^7.8.0",
    "tsx": "^4.23.1",
    "typescript": "^5",
    "typescript-eslint": "^8.68.0",
    "vitest": "^4.1.10"
  },
  "packageManager": "pnpm@11.22.0"
}
