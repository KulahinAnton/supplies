{
  "name": "supplies",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:db": "tsx scripts/smoke.ts",
    "postinstall": "prisma generate",
    "db:up": "docker compose up -d",
    "db:migrate": "prisma migrate dev",
    "db:seed": "prisma db seed",
    "db:studio": "prisma studio",
    "bot:start": "tsx bot/index.ts",
    "bot:dev": "tsx watch bot/index.ts",
    "bot:webhook:set": "tsx scripts/set-telegram-webhook.ts",
    "bot:webhook:delete": "tsx scripts/set-telegram-webhook.ts --delete",
    "bot:local": "tsx scripts/set-telegram-webhook.ts --delete && tsx watch bot/index.ts",
    "digest:run": "tsx scripts/run-daily-digest.ts",
    "backup:prod": "tsx scripts/backup-prod.ts",
    "backup:verify": "tsx scripts/backup-verify.ts",
    "db:prod-copy": "tsx scripts/prod-copy.ts",
    "migrate:deploy": "tsx scripts/migrate-deploy.ts",
    "prepare": "husky",
    "verify": "pnpm lint && pnpm typecheck && pnpm test",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.122.0",
    "@base-ui/react": "^1.6.0",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@hookform/resolvers": "^5.4.0",
    "@prisma/adapter-pg": "^7.8.0",
    "@prisma/client": "^7.8.0",
    "@supplies/core": "workspace:*",
    "@zxing/browser": "^0.1.5",
    "bcryptjs": "^3.0.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "decimal.js": "^10.6.0",
    "grammy": "^1.44.0",
    "lucide-react": "^1.24.0",
    "next": "16.3.1",
    "next-auth": "5.0.0-beta.31",
    "next-themes": "^0.4.6",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-hook-form": "^7.81.0",
    "server-only": "^0.0.1",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "dotenv": "^17.4.2",
    "eslint": "^9",
    "eslint-config-next": "16.3.1",
    "husky": "^9.1.7",
    "lint-staged": "^17.4.1",
    "prisma": "^7.8.0",
    "shadcn": "^4.18.0",
    "tailwindcss": "^4",
    "tsx": "^4.23.1",
    "typescript": "^5",
    "typescript-eslint": "^8.68.0",
    "vitest": "^4.1.10"
  },
  "packageManager": "pnpm@11.22.0"
}
