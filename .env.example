# Postgres (docker compose — host port 5434, see docker-compose.yml)
DATABASE_URL="postgresql://postgres:postgres@localhost:5434/supplies"

# Auth.js — generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
AUTH_SECRET=""

# Absolute base URL of the app — used to build password-reset and invite links.
APP_URL="http://localhost:3000"

# Transactional email (password reset, household invites) via Resend.
# Leave empty in dev — sending fails server-side but the UI never reveals that.
RESEND_API_KEY=""
EMAIL_FROM="Supplies <onboarding@resend.dev>"

# Telegram bot (Feature 9). Token from @BotFather.
# Leave empty to run the web app without the bot.
TELEGRAM_BOT_TOKEN=""
# Shared secret Telegram echoes back on every webhook call, so the route can
# reject anything that did not come from Telegram. Generate like AUTH_SECRET.
TELEGRAM_WEBHOOK_SECRET=""

# Optional Feature 10 override: where barcode lookups read product data.
# Defaults to https://world.openfoodfacts.org
# OFF_BASE_URL=""

# Bot username without the @ (e.g. "supplies_family_bot") — needed to build the
# t.me deep link that binds a Telegram chat to an account.
TELEGRAM_BOT_USERNAME=""

# Where `pnpm bot:webhook:set` points Telegram — the public HTTPS base URL of
# the deployment, e.g. "https://supplies-alpha.vercel.app". Deliberately
# separate from APP_URL so APP_URL can stay on localhost while you develop;
# switching between the deployed bot and a local one never touches it.
TELEGRAM_WEBHOOK_URL=""

# Feature 19 — guards GET /api/cron/digest. Vercel Cron sends it as
# `Authorization: Bearer <CRON_SECRET>`. Generate like AUTH_SECRET.
CRON_SECRET=""

# Feature 18.2 — an Open Food Facts account, so the app can contribute a
# product you named that its databases did not know. Optional: without these
# the app never offers to share anything.
OFF_USER=""
OFF_PASSWORD=""
GEPIR_BASE_URL=

# Only needed to run a PRODUCTION build locally (`pnpm build && pnpm start`).
# Auth.js trusts the host automatically under `next dev` and on Vercel, but a
# production build served from localhost refuses with "UntrustedHost".
# AUTH_TRUST_HOST=true

# METRO Ukraine barcode source (Feature 29). Defaults are fine.
# METRO_BASE_URL=""
# METRO_STORE_ID="00010"

# Feature 32 — recipe suggestions. Without this the Recipes page loads and the
# button says so plainly rather than failing; nothing else in the app needs it.
ANTHROPIC_API_KEY=
# Optional override. Defaults to claude-haiku-4-5, the cheapest model.
ANTHROPIC_MODEL=

# ─── @supplies/api (docs/ARCHITECTURE.md §5) ────────────────────────────────────
# Every origin is a variable with a working localhost default, so the first
# deploy is a matter of filling values in rather than editing code.
#
# Local port map, so nothing collides:
#   3000 next dev · 3100 playwright's production build · 3200 api · 5173 vite

# Signs API access and refresh tokens. Deliberately NOT AUTH_SECRET: that one
# signs Auth.js sessions and Telegram link tokens, and rotating it to fix one
# system should not sign everyone out of the other two. No default — a fallback
# secret is a fallback that reaches production. Generate like AUTH_SECRET.
API_JWT_SECRET=""

# API_PORT=3200
# Comma-separated allowlist of browser origins. Must be https:// in production.
# CORS_ORIGINS="http://localhost:5173,http://localhost:3000"

# Refresh-token cookie. Empty domain means host-only, which is right on
# localhost; set a shared parent (".supplies.app") once the SPA and the API sit
# on sibling subdomains. SameSite=none REQUIRES secure=true — browsers drop the
# cookie otherwise and the only symptom is a login that never sticks, so the
# API refuses to boot on that combination rather than letting you find out.
# COOKIE_DOMAIN=""
# COOKIE_SAMESITE="lax"
# COOKIE_SECURE="false"
# Whether to believe X-Forwarded-For. Leave off locally. Behind a host's proxy
# set the number of proxies in front of the API (usually 1) or their
# addresses/CIDRs, or the rate limiter sees one client: the proxy. "true"
# believes any X-Forwarded-For, so only use it when the API is unreachable
# except through the proxy.
# TRUST_PROXY="false"

# ACCESS_TOKEN_TTL="15m"
# REFRESH_TOKEN_TTL_DAYS=30

# Where the SPA and the React Native app look for the API. The phone needs a
# LAN IP rather than localhost — same reason TELEGRAM_WEBHOOK_URL is separate
# from APP_URL.
# VITE_API_URL="http://localhost:3200"
# EXPO_PUBLIC_API_URL="http://192.168.1.10:3200"
