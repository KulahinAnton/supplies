# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
node_modules/
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
.next/
out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# generated Prisma client — recreated by `pnpm prisma generate` (also postinstall)
/packages/db/src/generated

# the env templates ARE committed; real .env files are not
!.env.example
!.env.backup.example

# Database dumps — contain password hashes, emails and Telegram chat ids
backups/
.env.backup

# Playwright output. The report is worth reading and never worth committing.
test-results/
playwright-report/
blob-report/
.playwright/

# Compiler output (apps/api). `nest build` emits the API and the core sources
# it pulls in, which is a lot of files that are already tracked as source.
dist/

# Expo — the dev server's scratch directory and the bundle `expo export` writes.
# `.expo-export` is only ever produced to prove Metro resolves the workspace
# (apps/mobile/CLAUDE.md); nothing consumes it.
apps/mobile/.expo/
apps/mobile/.expo-export/
apps/mobile/expo-env.d.ts
