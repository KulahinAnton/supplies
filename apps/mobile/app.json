{
  "expo": {
    "name": "Запаси",
    "slug": "supplies",
    "version": "0.1.0",
    "orientation": "portrait",
    "scheme": "supplies",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "android": {
      "package": "ua.supplies.app",
      "adaptiveIcon": { "backgroundColor": "#297f48" },
      "edgeToEdgeEnabled": true
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "ua.supplies.app"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      [
        "expo-camera",
        {
          "cameraPermission": "Щоб сканувати штрихкоди товарів.",
          "recordAudioAndroid": false
        }
      ]
    ],
    "experiments": { "typedRoutes": true },
    "extra": {
      "apiUrl": "http://10.0.2.2:3200"
    }
  }
}
