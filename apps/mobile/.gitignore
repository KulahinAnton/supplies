# Managed workflow: the native projects are generated by `expo prebuild`, on
# EAS or locally when reproducing a build failure. They are output, not source
# — committing them would make this a bare project and the config plugins in
# app.config.ts would stop being the thing that decides the manifest.
/android
/ios

# Metro/Expo caches and the `expo export` bundle.
.expo/
.expo-export/

