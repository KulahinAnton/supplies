# Production backup credentials — used only by `pnpm backup:prod`.
# Copy to .env.backup (gitignored) and fill in.
#
# Use the DIRECT connection string from the Neon console, NOT the pooled one:
# turn "Connection pooling" OFF in Connection Details. The pooled host has
# "-pooler" in it and cannot serve a consistent dump.
DATABASE_URL_PROD=""

# The client image must be >= the Postgres version Neon runs (18.6 today).
# Override only if Neon moves to a newer major:
#   BACKUP_PG_IMAGE="postgres:19-alpine"
